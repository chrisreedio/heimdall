[Unit]
Description=Hourly Heimdall inventory push

[Timer]
# Soon after boot, so the hub sees the reboot and clears "reboot required".
OnBootSec=3min
# Hourly, so a silent host stands out within hours ([hosts] alert_after on
# the hub). Unchanged reports are stored as small heartbeats.
OnCalendar=hourly
# Spread hosts out so they don't all report at once, at a fixed offset per
# host so reports stay about an hour apart.
RandomizedDelaySec=15min
FixedRandomDelay=yes
Persistent=true

[Install]
WantedBy=timers.target
