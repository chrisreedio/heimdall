# Heimdall collector: (re)start the 60s countdown to a report. Started by
# heimdall-collect-changes.path on every package database change. Restarting
# the timer pushes the report back, so a burst of changes sends one report.
# It only talks to systemd; the report itself runs as heimdall in
# heimdall-collect.service.

[Unit]
Description=Schedule a Heimdall report after a package change
Documentation=https://github.com/chrisreedio/heimdall/blob/main/docs/collector.md
# A big upgrade changes the database many times a minute. Never rate-limit
# this, or the path unit would stop watching.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=systemctl restart --no-block heimdall-collect-soon.timer

# Root only to talk to systemd; it needs nothing else.
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
